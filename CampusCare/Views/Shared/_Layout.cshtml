<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-navy: #0b192c;
            --accent-blue: #0284c7;
            --soft-bg: #f8fafc;
        }
        body {
            background-color: var(--soft-bg);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-custom {
            background: linear-gradient(135deg, #0b192c 0%, #1e3a8a 100%);
            box-shadow: 0 4px 12px rgba(11, 25, 44, 0.15);
        }
        .navbar-brand {
            font-weight: 800;
            letter-spacing: -0.5px;
            font-size: 1.4rem;
        }
        .badge-pulse {
            opacity: 0.9;
        }
        .footer-custom {
            background-color: #0b192c;
            color: #94a3b8;
            margin-top: auto;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3">
            <div class="container">
                <a class="navbar-brand text-white d-flex align-items-center gap-2" asp-controller="Complaints" asp-action="Index">
                    <span class="p-2 bg-primary rounded-3 text-white"><i class="bi bi-shield-check"></i></span>
                    <span>Campus<span class="text-info">Care</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Complaints" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 fw-semibold" asp-controller="Complaints" asp-action="Create">
                                <i class="bi bi-plus-circle me-1"></i> Lodge Complaint
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 fw-semibold" asp-controller="Complaints" asp-action="Analytics">
                                <i class="bi bi-bar-chart-line me-1"></i> SLA Analytics
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill fw-bold">
                            <i class="bi bi-database me-1"></i> EF Core + MySQL
                        </span>
                        <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Complaints" asp-action="Create">
                            <i class="bi bi-megaphone-fill me-1"></i> Report Issue
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4 flex-grow-1">
        <!-- TempData Notification Alerts (State Management Demo) -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 border-start border-success border-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                    <div>
                        <strong class="d-block">Success! (TempData Alert)</strong>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 border-start border-danger border-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
                    <div>
                        <strong class="d-block">Attention Required</strong>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm border-0 border-start border-warning border-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-info-circle-fill fs-4 me-3 text-warning"></i>
                    <div>
                        <strong class="d-block">Action Completed</strong>
                        <span>@TempData["WarningMessage"]</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer-custom py-3">
        <div class="container text-center text-md-between d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div class="mb-2 mb-md-0">
                <span class="text-white fw-bold">CampusCare</span> &copy; 2026 - Web Technologies with .NET Mini Project
            </div>
            <div class="small">
                <span class="text-info">Architecture:</span> ASP.NET Core MVC | EF Core Code-First | MySQL 8.0 | Bootstrap 5
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
