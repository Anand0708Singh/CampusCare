@model CampusCare.Models.DashboardViewModel
@{
    ViewData["Title"] = "Facility Operations Dashboard";
}

<!-- TOP HERO & KPI CARDS -->
<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <h2 class="fw-bold mb-1 text-navy">Campus Facility Grievance Desk</h2>
        <p class="text-muted mb-0">Track, prioritize, and resolve campus maintenance tickets across departments.</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Lodge New Grievance
        </a>
    </div>
</div>

<!-- 4 KPI SUMMARY CARDS -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Reported</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalCount</h3>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                    <i class="bi bi-journals fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-danger border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Open Backlog</span>
                    <h3 class="fw-bold text-danger mb-0 mt-1">@Model.OpenCount</h3>
                </div>
                <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                    <i class="bi bi-exclamation-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">In Progress</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@Model.InProgressCount</h3>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                    <i class="bi bi-gear-wide-connected fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Resolved</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.ResolvedCount</h3>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-circle">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTER & SEARCH TOOLBAR -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchKeyword" value="@Model.SearchKeyword" class="form-control bg-light border-0" placeholder="Search by title, location, or reporter..." />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select name="categoryId" class="form-select bg-light border-0">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.SelectedCategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="status" class="form-select bg-light border-0" asp-items="Html.GetEnumSelectList<CampusCare.Models.ComplaintStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100 rounded-3">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- COMPLAINT RECORDS TABLE (CRUD: READ) -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Ticket</th>
                    <th>Category & Location</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Reported By</th>
                    <th>Date</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Complaints.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No grievance tickets match your filter criteria.
                        </td>
                    </tr>
                }
                @foreach (var item in Model.Complaints)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="fw-bold text-navy">#@item.Id</span>
                            <div class="fw-semibold text-dark">@item.Title</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi @item.Category?.IconClass me-1 text-primary"></i>
                                @item.Category?.Name
                            </span>
                            <div class="small text-muted mt-1"><i class="bi bi-geo-alt me-1"></i>@item.Location</div>
                        </td>
                        <td>
                            @switch (item.Priority)
                            {
                                case CampusCare.Models.ComplaintPriority.Urgent:
                                    <span class="badge bg-danger text-white px-2 py-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Urgent</span>
                                    break;
                                case CampusCare.Models.ComplaintPriority.High:
                                    <span class="badge bg-warning-subtle text-dark border border-warning px-2 py-1">High</span>
                                    break;
                                case CampusCare.Models.ComplaintPriority.Medium:
                                    <span class="badge bg-info-subtle text-info-emphasis px-2 py-1">Medium</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Low</span>
                                    break;
                            }
                        </td>
                        <td>
                            @switch (item.Status)
                            {
                                case CampusCare.Models.ComplaintStatus.Open:
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">Open</span>
                                    break;
                                case CampusCare.Models.ComplaintStatus.InProgress:
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-3 py-1 rounded-pill">In Progress</span>
                                    break;
                                case CampusCare.Models.ComplaintStatus.Resolved:
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Resolved</span>
                                    break;
                                default:
                                    <span class="badge bg-dark-subtle text-dark px-3 py-1 rounded-pill">Closed</span>
                                    break;
                            }
                        </td>
                        <td>
                            <div class="fw-medium">@item.ReporterName</div>
                            <div class="small text-muted">@item.ReporterEmail</div>
                        </td>
                        <td>
                            <span class="small text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit / Update Status">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

