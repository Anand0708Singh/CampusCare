@model CampusCare.Models.Complaint
@{
    ViewData["Title"] = "Withdraw Complaint #" + Model.Id;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden border-top border-danger border-4">
            <div class="card-body p-4 text-center">
                <div class="p-3 bg-danger-subtle text-danger rounded-circle d-inline-block mb-3">
                    <i class="bi bi-trash3 fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Delete Grievance Ticket?</h4>
                <p class="text-muted mb-4">
                    Are you sure you want to permanently remove Ticket <strong>#@Model.Id: @Model.Title</strong>? This action cannot be reversed.
                </p>

                <div class="text-start bg-light p-3 rounded-3 mb-4">
                    <div class="small text-muted mb-1">LOCATION: <span class="fw-semibold text-dark">@Model.Location</span></div>
                    <div class="small text-muted mb-1">STATUS: <span class="badge bg-secondary">@Model.Status</span></div>
                    <div class="small text-muted">REPORTED BY: <span class="fw-semibold text-dark">@Model.ReporterName (@Model.ReporterEmail)</span></div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold">
                            <i class="bi bi-trash-fill me-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

